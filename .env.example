# Backend only. Never prefix credentials with VITE_.
# Use Railway DATABASE_PUBLIC_URL, or public PgBouncer URL when configured.
DATABASE_URL=
# Optional trusted CA certificate, PEM. Use literal \\n for newlines in hosting variables.
DATABASE_CA_CERT=
# Canonical HTTPS origin on Vercel. Leave blank for local development.
APP_ORIGIN=
# Used only by npm run admin:create. Never sent to browser.
ADMIN_EMAIL=
ADMIN_PASSWORD=
